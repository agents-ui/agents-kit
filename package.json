{
  "name": "agents-ui-kit",
  "version": "0.2.0",
  "description": "React components for generative UI and agent interactions",
  "author": "Abhishek Gahlot <me@abhishek.it>",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/agents-ui/agents-kit"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "components/agents-ui",
    "components/blocks",
    "components/blocks-so",
    "components/boardui",
    "components/prompt-kit",
    "components/ui",
    "hooks",
    "lib",
    "styles",
    "public/c",
    "public/h",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "components/beautiful-ui",
    "components/beui",
    "CHANGELOG.md",
    "docs/migrating-to-v0.2.md",
    "components/effects",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:registry && npm run generate-llms-txt && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.tsx",
    "build:registry": "tsx scripts/registry-build.ts",
    "generate-llms-txt": "tsx scripts/generate-llms-txt.ts",
    "build:static": "npm run build",
    "build:github": "NEXT_PUBLIC_BASE_PATH=/agents-kit npm run build",
    "serve:static": "npx serve out",
    "deploy:gh-pages": "npm run build:github && npx gh-pages -d out",
    "verify:distribution": "tsx scripts/verify-distribution.ts",
    "check:llms": "npm run generate-llms-txt -- --check"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.1.7",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@remixicon/react": "^4.9.0",
    "@types/mdx": "^2.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codehike": "^1.0.4",
    "lucide-react": "^0.475.0",
    "marked": "^15.0.7",
    "motion": "^12.4.5",
    "next": "15.1.7",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.0.0",
    "react-jsx-parser": "^2.4.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "use-stick-to-bottom": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "prettier": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "resolutions": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0"
  }
}
